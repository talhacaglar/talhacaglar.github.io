---
import { translations, DEFAULT_LANG } from '../data/translations';
const t = translations[DEFAULT_LANG];
---

<section class="section education" id="education">
  <div class="container">
    <div class="reveal">
      <span class="section-label" data-i18n="education.label">{t['education.label'] || 'Education'}</span>
      <h2 class="section-title" data-i18n="education.title">{t['education.title'] || 'My Education'}</h2>
    </div>

    <div class="education-content reveal" style="--delay: 0.1s">
      <div class="education-card glass">
        <h3 class="university" data-i18n="education.university">{t['education.university'] || 'Sakarya Uygulamalı Bilimler Üniversitesi'}</h3>
        <p class="degree" data-i18n="education.degree">{t['education.degree'] || 'Lisans Derecesi, Bilgisayar Mühendisliği'}</p>
        <p class="date" data-i18n="education.date">{t['education.date'] || 'Ekim 2023 - Haziran 2027'}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .education {
    position: relative;
  }

  .education-content {
    max-width: 600px;
    margin: 3rem auto 0;
  }

  .education-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    transition:
      transform 0.55s var(--ease),
      background-color 0.35s var(--ease-smooth),
      box-shadow 0.55s var(--ease);
  }

  .education-card:hover {
    transform: translateY(-4px);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-shadow-hover), var(--glass-rim);
  }

  .university {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .degree {
    font-size: 1.1rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .date {
    font-size: 0.95rem;
    color: var(--text-muted);
  }
</style>
