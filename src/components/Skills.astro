---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];

const groups = [
  {
    key: 'skills.cat1',
    tone: 'var(--blue)',
    items: ['Python', 'JavaScript', 'Java', 'Bash', 'F#', 'Dart', 'CSS'],
  },
  {
    key: 'skills.cat2',
    tone: 'var(--violet)',
    items: ['Flutter', 'Electron', 'PyQt6', 'Firebase', 'SQLite', 'Git'],
  },
  {
    key: 'skills.cat3',
    tone: 'var(--teal)',
    items: ['Linux', 'Arch Linux', 'Wayland', 'Hyprland', 'systemd', 'Networking'],
  },
] as const;
---

<section class="section skills" id="skills">
  <div class="container">
    <div class="reveal">
      <span class="section-label" style="--tone: var(--teal)" data-i18n="skills.label">
        {t['skills.label']}
      </span>
      <h2 class="section-title" data-i18n="skills.title">{t['skills.title']}</h2>
      <p class="section-subtitle" data-i18n="skills.subtitle">{t['skills.subtitle']}</p>
    </div>

    <div class="groups">
      {
        groups.map((group, i) => (
          <div
            class="group reveal"
            style={`--tone: ${group.tone}; transition-delay: ${0.08 * (i + 1)}s`}
          >
            <h3 class="group-title" data-i18n={group.key}>
              {t[group.key]}
            </h3>
            <ul class="pills">
              {group.items.map((item) => (
                <li class="pill">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    position: relative;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .skills::before {
    content: '';
    position: absolute;
    top: -35%;
    right: -10%;
    width: min(720px, 80vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--teal) var(--glow-strength), transparent) 0%,
      transparent 66%
    );
    filter: blur(60px);
    pointer-events: none;
  }

  .container {
    position: relative;
  }

  .groups {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 1rem;
  }

  .group {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--tone) var(--tint-strength), var(--card-bg));
    border: 1px solid color-mix(in oklab, var(--tone) 20%, transparent);
    transition:
      transform 0.55s var(--ease),
      border-color 0.35s var(--ease-smooth),
      opacity 0.9s var(--ease);
  }

  .group:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--tone) 42%, transparent);
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--tone);
    margin-bottom: 1.25rem;
  }

  .group-title::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px color-mix(in oklab, currentColor 22%, transparent);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .pill {
    padding: 0.4375rem 0.9375rem;
    background: var(--pill-bg);
    border: 1px solid var(--border);
    border-radius: 980px;
    font-size: 0.875rem;
    letter-spacing: -0.005em;
    color: var(--text);
    transition:
      transform 0.4s var(--ease),
      border-color 0.3s var(--ease-smooth),
      background-color 0.3s var(--ease-smooth),
      color 0.3s var(--ease-smooth);
  }

  .pill:hover {
    transform: translateY(-2px);
    background: color-mix(in oklab, var(--tone) var(--tint-strength-strong), var(--pill-bg));
    border-color: color-mix(in oklab, var(--tone) 45%, transparent);
    color: var(--tone);
  }
</style>
