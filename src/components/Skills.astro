---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];

const groups = [
  {
    key: 'skills.cat1',
    items: ['Python', 'JavaScript', 'Java', 'Bash', 'F#', 'Dart', 'CSS'],
  },
  {
    key: 'skills.cat2',
    items: ['Flutter', 'Electron', 'PyQt6', 'Firebase', 'SQLite', 'Git'],
  },
  {
    key: 'skills.cat3',
    items: ['Linux', 'Arch Linux', 'Wayland', 'Hyprland', 'systemd', 'Networking'],
  },
] as const;
---

<section class="section skills" id="skills">
  <div class="container">
    <div class="reveal">
      <span class="section-label" data-i18n="skills.label">{t['skills.label']}</span>
      <h2 class="section-title" data-i18n="skills.title">{t['skills.title']}</h2>
      <p class="section-subtitle" data-i18n="skills.subtitle">{t['skills.subtitle']}</p>
    </div>

    <div class="groups">
      {
        groups.map((group, i) => (
          <div class="group glass reveal" style={`transition-delay: ${0.08 * (i + 1)}s`}>
            <h3 class="group-title" data-i18n={group.key}>
              {t[group.key]}
            </h3>
            <ul class="pills">
              {group.items.map((item) => (
                <li class="pill">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    position: relative;
    background: var(--section-veil);
    border-block: 1px solid var(--border);
  }

  .groups {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 1rem;
  }

  .group {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    transition:
      transform 0.55s var(--ease),
      background-color 0.35s var(--ease-smooth),
      box-shadow 0.55s var(--ease),
      opacity 0.9s var(--ease);
  }

  .group:hover {
    transform: translateY(-4px);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-shadow-hover), var(--glass-rim);
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .group-title::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px var(--tint-strong);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .pill {
    padding: 0.4375rem 0.9375rem;
    background: var(--glass-bg-faint);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-rim);
    border-radius: 980px;
    font-size: 0.875rem;
    letter-spacing: -0.005em;
    color: var(--text);
    transition:
      transform 0.4s var(--ease),
      background-color 0.3s var(--ease-smooth),
      color 0.3s var(--ease-smooth);
  }

  .pill:hover {
    transform: translateY(-2px);
    background: var(--tint-strong);
    color: var(--accent);
  }
</style>
