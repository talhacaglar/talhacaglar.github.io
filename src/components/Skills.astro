---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];

const groups = [
  {
    key: 'skills.cat1',
    items: ['Python', 'JavaScript', 'Java', 'Bash', 'F#', 'Dart', 'CSS'],
  },
  {
    key: 'skills.cat2',
    items: ['Flutter', 'Electron', 'PyQt6', 'Firebase', 'SQLite', 'Git'],
  },
  {
    key: 'skills.cat3',
    items: ['Linux', 'Arch Linux', 'Wayland', 'Hyprland', 'systemd', 'Networking'],
  },
] as const;
---

<section class="section skills" id="skills">
  <div class="container">
    <div class="reveal">
      <span class="section-label" data-i18n="skills.label">{t['skills.label']}</span>
      <h2 class="section-title" data-i18n="skills.title">{t['skills.title']}</h2>
      <p class="section-subtitle" data-i18n="skills.subtitle">{t['skills.subtitle']}</p>
    </div>

    <div class="groups">
      {
        groups.map((group, i) => (
          <div class="group reveal" style={`transition-delay: ${0.08 * (i + 1)}s`}>
            <h3 class="group-title" data-i18n={group.key}>
              {t[group.key]}
            </h3>
            <ul class="pills">
              {group.items.map((item) => (
                <li class="pill">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    background: var(--bg-elevated);
  }

  .groups {
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .group-title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 1.125rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    list-style: none;
  }

  .pill {
    padding: 0.5rem 1.125rem;
    background: var(--pill-bg);
    border: 1px solid var(--border);
    border-radius: 980px;
    font-size: 0.9375rem;
    letter-spacing: -0.005em;
    color: var(--text);
    transition:
      transform 0.4s var(--ease),
      border-color 0.3s var(--ease-smooth);
  }

  .pill:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
  }
</style>
