---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];

const facts = [
  { value: 'hero.fact1.value', label: 'hero.fact1.label', tone: 'var(--blue)' },
  { value: 'hero.fact2.value', label: 'hero.fact2.label', tone: 'var(--violet)' },
  { value: 'hero.fact3.value', label: 'hero.fact3.label', tone: 'var(--teal)' },
] as const;
---

<section class="hero" id="top">
  <div class="mesh" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
  </div>

  <div class="container inner">
    <p class="badge">
      <span class="dot" aria-hidden="true"></span>
      <span data-i18n="hero.eyebrow">{t['hero.eyebrow']}</span>
    </p>

    <h1 class="title">
      <span class="line" data-i18n="hero.titleLine1">{t['hero.titleLine1']}</span>
      <span class="line accent" data-i18n="hero.titleLine2">{t['hero.titleLine2']}</span>
    </h1>

    <p class="subtitle" data-i18n="hero.subtitle">{t['hero.subtitle']}</p>

    <div class="actions">
      <a href="#projects" class="btn btn-primary" data-i18n="hero.ctaPrimary">
        {t['hero.ctaPrimary']}
      </a>
      <a href="#contact" class="btn btn-secondary" data-i18n="hero.ctaSecondary">
        {t['hero.ctaSecondary']}
      </a>
    </div>

    <ul class="facts">
      {
        facts.map((fact) => (
          <li class="fact" style={`--tone: ${fact.tone}`}>
            <span class="fact-value" data-i18n={fact.value}>
              {t[fact.value]}
            </span>
            <span class="fact-label" data-i18n={fact.label}>
              {t[fact.label]}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-block: 7.5rem 4rem;
  }

  /* ---------- Renkli mesh arka plan ---------- */

  .mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.9;
  }

  .orb-1 {
    top: -18%;
    left: 6%;
    width: min(660px, 72vw);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--blue) var(--glow-strength), transparent) 0%,
      transparent 68%
    );
    animation: float-1 20s ease-in-out infinite alternate;
  }

  .orb-2 {
    top: 2%;
    right: 0%;
    width: min(620px, 68vw);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--violet) var(--glow-strength), transparent) 0%,
      transparent 68%
    );
    animation: float-2 24s ease-in-out infinite alternate;
  }

  .orb-3 {
    bottom: -22%;
    left: 32%;
    width: min(700px, 78vw);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--teal) var(--glow-strength), transparent) 0%,
      transparent 68%
    );
    animation: float-3 28s ease-in-out infinite alternate;
  }

  @keyframes float-1 {
    to {
      transform: translate(9%, 7%) scale(1.14);
    }
  }

  @keyframes float-2 {
    to {
      transform: translate(-11%, 9%) scale(1.1);
    }
  }

  @keyframes float-3 {
    to {
      transform: translate(7%, -9%) scale(1.16);
    }
  }

  /* ---------- İçerik ---------- */

  .inner {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 1rem 0.4375rem 0.875rem;
    border-radius: 980px;
    background: color-mix(in oklab, var(--card-bg) 72%, transparent);
    border: 1px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--text-muted);
    animation: rise 1s var(--ease) 0.05s both;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #30d158;
    box-shadow: 0 0 0 3px color-mix(in oklab, #30d158 25%, transparent);
    animation: pulse 2.4s var(--ease-smooth) infinite;
  }

  .title {
    margin-top: 1.75rem;
    font-size: clamp(3.25rem, 12vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.94;
    animation: rise 1.1s var(--ease) 0.15s both;
  }

  .line {
    display: block;
  }

  .line.accent {
    background: linear-gradient(
      100deg,
      var(--blue) 0%,
      var(--violet) 42%,
      var(--pink) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .subtitle {
    margin-top: 1.75rem;
    max-width: 42ch;
    font-size: clamp(1.0625rem, 2.2vw, 1.3125rem);
    line-height: 1.5;
    color: var(--text-muted);
    letter-spacing: -0.01em;
    animation: rise 1.1s var(--ease) 0.3s both;
  }

  .actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    animation: rise 1.1s var(--ease) 0.45s both;
  }

  .facts {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.875rem;
    width: 100%;
    max-width: 720px;
    list-style: none;
    animation: rise 1.1s var(--ease) 0.6s both;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.125rem 1.25rem;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--tone) var(--tint-strength), var(--card-bg));
    border: 1px solid color-mix(in oklab, var(--tone) 22%, transparent);
    transition:
      transform 0.5s var(--ease),
      border-color 0.35s var(--ease-smooth);
  }

  .fact:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--tone) 45%, transparent);
  }

  .fact-value {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--tone);
  }

  .fact-label {
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.01em;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @media (max-width: 720px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 0.625rem;
      margin-top: 3rem;
    }

    .fact {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.875rem 1.125rem;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge,
    .title,
    .subtitle,
    .actions,
    .facts,
    .dot,
    .orb {
      animation: none;
    }
  }
</style>
