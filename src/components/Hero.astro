---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];

const facts = [
  { value: 'hero.fact1.value', label: 'hero.fact1.label' },
  { value: 'hero.fact2.value', label: 'hero.fact2.label' },
  { value: 'hero.fact3.value', label: 'hero.fact3.label' },
] as const;
---

<section class="hero" id="top">
  <!-- Arka plandaki nokta dokusunu bulanıklaştıran cam mercekler -->
  <div class="lenses" aria-hidden="true">
    <span class="lens lens-1"></span>
    <span class="lens lens-2"></span>
    <span class="lens lens-3"></span>
  </div>

  <div class="container inner">
    <p class="badge">
      <span class="dot" aria-hidden="true"></span>
      <span data-i18n="hero.eyebrow">{t['hero.eyebrow']}</span>
    </p>

    <h1 class="title">
      <span class="line" data-i18n="hero.titleLine1">{t['hero.titleLine1']}</span>
      <span class="line accent" data-i18n="hero.titleLine2">{t['hero.titleLine2']}</span>
    </h1>

    <p class="role" data-i18n="hero.role">{t['hero.role']}</p>

    <p class="subtitle" data-i18n="hero.subtitle">{t['hero.subtitle']}</p>

    <div class="actions">
      <a href="#projects" class="btn btn-primary" data-i18n="hero.ctaPrimary">
        {t['hero.ctaPrimary']}
      </a>
      <a href="#contact" class="btn btn-secondary" data-i18n="hero.ctaSecondary">
        {t['hero.ctaSecondary']}
      </a>
    </div>

    <ul class="facts">
      {
        facts.map((fact) => (
          <li class="fact glass">
            <span class="fact-value" data-i18n={fact.value}>
              {t[fact.value]}
            </span>
            <span class="fact-label" data-i18n={fact.label}>
              {t[fact.label]}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-block: 7.5rem 4rem;
  }

  /* ---------- Cam mercekler ---------- */

  .lenses {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .lens {
    position: absolute;
    border-radius: 50%;
    background: var(--glass-bg-faint);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border: 1px solid var(--glass-border);
    box-shadow:
      var(--glass-shadow),
      var(--glass-rim);
  }

  .lens-1 {
    top: 8%;
    left: 4%;
    width: min(320px, 34vw);
    aspect-ratio: 1;
    animation: drift-1 22s ease-in-out infinite alternate;
  }

  .lens-2 {
    top: 46%;
    right: 3%;
    width: min(240px, 26vw);
    aspect-ratio: 1;
    animation: drift-2 26s ease-in-out infinite alternate;
  }

  .lens-3 {
    bottom: 6%;
    left: 24%;
    width: min(160px, 18vw);
    aspect-ratio: 1;
    animation: drift-3 19s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    to {
      transform: translate(14%, 10%) scale(1.08);
    }
  }

  @keyframes drift-2 {
    to {
      transform: translate(-16%, -12%) scale(1.12);
    }
  }

  @keyframes drift-3 {
    to {
      transform: translate(20%, -14%) scale(1.06);
    }
  }

  /* ---------- İçerik ---------- */

  .inner {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 1rem 0.4375rem 0.875rem;
    border-radius: 980px;
    background: var(--glass-bg);
    backdrop-filter: blur(16px) saturate(170%);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow), var(--glass-rim);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--text-muted);
    animation: rise 1s var(--ease) 0.05s both;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--tint-strong);
    animation: pulse 2.4s var(--ease-smooth) infinite;
  }

  .title {
    margin-top: 1.75rem;
    font-size: clamp(3.25rem, 12vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.94;
    animation: rise 1.1s var(--ease) 0.15s both;
  }

  .line {
    display: block;
  }

  .line.accent {
    color: var(--accent);
  }

  .subtitle {
    margin-top: 1.75rem;
    max-width: 42ch;
    font-size: clamp(1.0625rem, 2.2vw, 1.3125rem);
    line-height: 1.5;
    color: var(--text-muted);
    letter-spacing: -0.01em;
    animation: rise 1.1s var(--ease) 0.3s both;
  }

  .role {
    margin-top: 1.25rem;
    font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--accent);
    animation: rise 1.1s var(--ease) 0.22s both;
  }

  .actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    animation: rise 1.1s var(--ease) 0.45s both;
  }

  .facts {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.875rem;
    width: 100%;
    max-width: 720px;
    list-style: none;
    animation: rise 1.1s var(--ease) 0.6s both;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.125rem 1.25rem;
    border-radius: var(--radius);
    transition:
      transform 0.5s var(--ease),
      background-color 0.35s var(--ease-smooth),
      box-shadow 0.5s var(--ease);
  }

  .fact:hover {
    transform: translateY(-3px);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-shadow-hover), var(--glass-rim);
  }

  .fact-value {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .fact-label {
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.01em;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (max-width: 720px) {
    .lens-2,
    .lens-3 {
      display: none;
    }

    .facts {
      grid-template-columns: 1fr;
      gap: 0.625rem;
      margin-top: 3rem;
    }

    .fact {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.875rem 1.125rem;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge,
    .title,
    .role,
    .subtitle,
    .actions,
    .facts,
    .dot,
    .lens {
      animation: none;
    }
  }
</style>
