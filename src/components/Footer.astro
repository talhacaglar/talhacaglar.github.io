---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p>© {year} Talha Çağlar. <span data-i18n="footer.rights">{t['footer.rights']}</span></p>
    <p data-i18n="footer.built">{t['footer.built']}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 2.5rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }
</style>
