---
import { translations, DEFAULT_LANG } from '../data/translations';
import { certifications } from '../data/certifications';

const t = translations[DEFAULT_LANG];
---

<section class="section certifications" id="certifications">
  <div class="container">
    <div class="reveal">
      <span class="section-label" data-i18n="certifications.label">
        {t['certifications.label']}
      </span>
      <h2 class="section-title" data-i18n="certifications.title">
        {t['certifications.title']}
      </h2>
      <p class="section-subtitle" data-i18n="certifications.subtitle">
        {t['certifications.subtitle']}
      </p>
    </div>

    <div class="grid">
      {
        certifications.map((cert, i) => {
          const Tag = cert.url ? 'a' : 'div';
          const linkProps = cert.url
            ? { href: cert.url, target: '_blank', rel: 'noopener noreferrer' }
            : {};
          return (
            <Tag
              class="card glass reveal"
              style={`transition-delay: ${0.07 * (i + 1)}s`}
              {...linkProps}
            >
              {cert.thumbnail && (
                <div class="card-thumb">
                  <img
                    src={cert.thumbnail}
                    alt={cert.name}
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="thumb-overlay" aria-hidden="true"></div>
                </div>
              )}

              <div class="card-body">
                <div class="card-head">
                  <span class="badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="8" r="6" />
                      <path d="M9 13.5 7 22l5-3 5 3-2-8.5" />
                    </svg>
                  </span>
                  {cert.url && (
                    <svg
                      class="arrow"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17L17 7M17 7H8M17 7v9" />
                    </svg>
                  )}
                </div>

                <h3 class="name">{cert.name}</h3>
                <p class="issuer">{cert.issuer}</p>
                <p class="date">{cert.date}</p>

                {cert.credentialId && <p class="credential-id">{cert.credentialId}</p>}
              </div>
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .certifications {
    position: relative;
    background: var(--section-veil);
    border-block: 1px solid var(--border);
  }

  .grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform 0.55s var(--ease),
      background-color 0.35s var(--ease-smooth),
      box-shadow 0.55s var(--ease),
      opacity 0.9s var(--ease);
    will-change: transform;
  }

  a.card:hover {
    transform: translateY(-6px);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-shadow-hover), var(--glass-rim);
  }

  /* ---------- Sertifika önizleme görseli ---------- */

  .card-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--glass-border);
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.6s var(--ease);
  }

  a.card:hover .card-thumb img {
    transform: scale(1.05);
  }

  .thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 60%,
      var(--glass-bg-faint) 100%
    );
    pointer-events: none;
  }

  /* ---------- Kart gövdesi ---------- */

  .card-body {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.75rem 1.75rem;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.125rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--accent);
    background: var(--tint-strong);
  }

  .badge svg {
    width: 18px;
    height: 18px;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--text-faint);
    transition:
      transform 0.45s var(--ease),
      color 0.3s var(--ease-smooth);
  }

  a.card:hover .arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  .name {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .issuer {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .date {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .credential-id {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }
</style>
