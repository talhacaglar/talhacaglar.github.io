---
import { translations, DEFAULT_LANG } from '../data/translations';
import { projects } from '../data/projects';

const t = translations[DEFAULT_LANG];
---

<section class="section projects" id="projects">
  <div class="container">
    <div class="reveal">
      <span class="section-label" data-i18n="projects.label">{t['projects.label']}</span>
      <h2 class="section-title" data-i18n="projects.title">{t['projects.title']}</h2>
      <p class="section-subtitle" data-i18n="projects.subtitle">{t['projects.subtitle']}</p>
    </div>

    <div class="grid">
      {
        projects.map((project, i) => (
          <a
            class="card glass reveal"
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            style={`transition-delay: ${0.07 * (i + 1)}s`}
          >
            <div class="card-head">
              <span class="index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <svg
                class="arrow"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M17 7H8M17 7v9" />
              </svg>
            </div>

            <h3 class="name">{project.name}</h3>

            <p class="desc" data-project-desc={i}>
              {project.description.tr}
            </p>

            <ul class="tags">
              {project.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </a>
        ))
      }
    </div>

    <div class="more reveal">
      <a
        class="btn btn-secondary"
        href="https://github.com/talhacaglar?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="projects.viewAll"
      >
        {t['projects.viewAll']}
      </a>
    </div>
  </div>
</section>

<script>
  import { projects } from '../data/projects';

  // Proje açıklamaları data dosyasından geldiği için i18n.js'in
  // data-i18n sözlüğüne değil, bu ayrı eşlemeye ihtiyaç duyar.
  const sync = (lang) => {
    document.querySelectorAll('[data-project-desc]').forEach((el) => {
      const project = projects[Number(el.dataset.projectDesc)];
      if (project) el.textContent = project.description[lang] ?? project.description.tr;
    });
  };

  sync(document.documentElement.lang === 'en' ? 'en' : 'tr');

  new MutationObserver(() =>
    sync(document.documentElement.lang === 'en' ? 'en' : 'tr')
  ).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
</script>

<style>
  .grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    transition:
      transform 0.55s var(--ease),
      background-color 0.35s var(--ease-smooth),
      box-shadow 0.55s var(--ease),
      opacity 0.9s var(--ease);
    will-change: transform;
  }

  .card:hover {
    transform: translateY(-6px);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-shadow-hover), inset 0 1px 0 var(--glass-highlight);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.125rem;
  }

  .index {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
    padding: 0.25rem 0.5rem;
    border-radius: 8px;
    background: var(--tint-strong);
  }

  .name {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--text-faint);
    transition:
      transform 0.45s var(--ease),
      color 0.3s var(--ease-smooth);
  }

  .card:hover .arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  .desc {
    margin-top: 0.75rem;
    flex: 1;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-muted);
    letter-spacing: -0.005em;
  }

  .tags {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4375rem;
    list-style: none;
  }

  .tag {
    padding: 0.3125rem 0.6875rem;
    border-radius: 980px;
    background: var(--tint);
    border: 1px solid var(--glass-border);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .more {
    margin-top: 2.75rem;
    display: flex;
    justify-content: center;
    transition-delay: 0.1s;
  }
</style>
