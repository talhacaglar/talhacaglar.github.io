---
import { translations, DEFAULT_LANG } from '../data/translations';
import { certifications } from '../data/certifications';

const t = translations[DEFAULT_LANG];

const links = [
  { href: '#about', key: 'nav.about' },
  { href: '#skills', key: 'nav.skills' },
  ...(certifications.length > 0
    ? [{ href: '#certifications', key: 'nav.certifications' } as const]
    : []),
  { href: '#projects', key: 'nav.projects' },
  { href: '#contact', key: 'nav.contact' },
] as const;
---

<header class="nav" data-nav>
  <nav class="bar" aria-label="Main">
    <div
      class="theme"
      role="group"
      data-i18n-attr="aria-label:nav.themeLabel"
      aria-label={t['nav.themeLabel']}
    >
      <span class="theme-pill" aria-hidden="true"></span>

      <button
        class="theme-btn"
        data-theme-set="light"
        data-i18n-attr="aria-label:nav.themeLight"
        aria-label={t['nav.themeLight']}
        aria-pressed="true"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
        </svg>
      </button>

      <button
        class="theme-btn"
        data-theme-set="dark"
        data-i18n-attr="aria-label:nav.themeDark"
        aria-label={t['nav.themeDark']}
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </div>

    <div class="links-wrap">
      <span class="indicator" data-nav-indicator aria-hidden="true"></span>
      <ul class="links" data-nav-links>
        {
          links.map((link) => (
            <li>
              <a href={link.href} data-i18n={link.key}>
                {t[link.key]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <button
      class="lang"
      data-lang-toggle
      data-i18n-attr="aria-label:nav.langLabel"
      aria-label={t['nav.langLabel']}
    >
      <span data-lang-indicator>EN</span>
    </button>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    top: clamp(0.75rem, 2vw, 1.125rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: min(var(--container), calc(100% - clamp(1.5rem, 5vw, 3rem)));
  }

  /* Yüzen cam kapsül */
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 60px;
    padding: 0 0.5rem;
    border-radius: 980px;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(190%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(190%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow), var(--glass-rim);
    transition:
      height 0.5s var(--ease),
      background-color 0.4s var(--ease-smooth),
      box-shadow 0.5s var(--ease);
  }

  /* Sayfa kaydıkça kapsül biraz toplanır ve zemine daha çok oturur */
  .nav.is-scrolled .bar {
    height: 52px;
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-shadow-hover), var(--glass-rim);
  }

  /* ---------- Tema seçici ---------- */

  .theme {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 980px;
    background: var(--glass-bg-faint);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-rim);
  }

  /* Aktif temanın altındaki cam yuvarlak */
  .theme-pill {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--tint-strong);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-rim);
    transition: transform 0.5s var(--ease);
  }

  :global(:root[data-theme='dark']) .theme-pill {
    transform: translateX(36px);
  }

  .theme-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--text-faint);
    transition:
      color 0.3s var(--ease-smooth),
      transform 0.4s var(--ease);
  }

  .theme-btn svg {
    width: 16px;
    height: 16px;
  }

  .theme-btn:hover {
    color: var(--text-muted);
  }

  .theme-btn[aria-pressed='true'] {
    color: var(--accent);
  }

  .theme-btn:active {
    transform: scale(0.9);
  }

  /* ---------- Linkler ---------- */

  /* Kapsülün iki yanındaki denetimler farklı genişlikte olduğu için linkleri
     akıştan çıkarıp çubuğun tam ortasına sabitliyoruz */
  .links-wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    justify-content: center;
  }

  /* Aktif bölümün altında kayan cam hap */
  .indicator {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0;
    height: 36px;
    border-radius: 980px;
    background: var(--tint);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-rim);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      left 0.55s var(--ease),
      width 0.55s var(--ease),
      opacity 0.4s var(--ease-smooth);
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 0.75rem);
    list-style: none;
  }

  .links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 0.9375rem;
    border-radius: 980px;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-muted);
    transition: color 0.3s var(--ease-smooth);
  }

  .links a:hover,
  .links a[data-active] {
    color: var(--accent);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    height: 40px;
    padding: 0 0.75rem;
    border-radius: 980px;
    background: var(--glass-bg-faint);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-rim);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    transition:
      background-color 0.3s var(--ease-smooth),
      box-shadow 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .lang:hover {
    background: var(--tint-strong);
    box-shadow: var(--glass-shadow), var(--glass-rim);
    transform: scale(1.06);
  }

  .lang:active {
    transform: scale(0.94);
  }

  @media (max-width: 640px) {
    .links-wrap {
      display: none;
    }
  }
</style>
