---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];

const links = [
  { href: '#about', key: 'nav.about' },
  { href: '#skills', key: 'nav.skills' },
  { href: '#projects', key: 'nav.projects' },
  { href: '#contact', key: 'nav.contact' },
] as const;
---

<header class="nav" data-nav>
  <nav class="bar" aria-label="Main">
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} data-i18n={link.key}>
              {t[link.key]}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      class="lang"
      data-lang-toggle
      data-i18n-attr="aria-label:nav.langLabel"
      aria-label={t['nav.langLabel']}
    >
      <span data-lang-indicator>EN</span>
    </button>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    top: clamp(0.75rem, 2vw, 1.125rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: min(var(--container), calc(100% - clamp(1.5rem, 5vw, 3rem)));
  }

  /* Yüzen cam kapsül */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 56px;
    padding: 0 0.625rem;
    border-radius: 980px;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(180%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(180%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow), inset 0 1px 0 var(--glass-highlight);
    transition:
      background-color 0.4s var(--ease-smooth),
      box-shadow 0.4s var(--ease);
  }

  .nav.is-scrolled .bar {
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-shadow-hover), inset 0 1px 0 var(--glass-highlight);
  }

  /* Logo yok: linkler kapsülün ortasında, dil düğmesi sağda durur */
  .links {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    list-style: none;
    padding-left: 48px;
  }

  .links a {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-muted);
    transition: color 0.3s var(--ease-smooth);
  }

  .links a:hover {
    color: var(--accent);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    height: 36px;
    padding: 0 0.75rem;
    border-radius: 980px;
    background: var(--tint);
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    transition:
      background-color 0.3s var(--ease-smooth),
      transform 0.4s var(--ease);
  }

  .lang:hover {
    background: var(--tint-strong);
    transform: scale(1.05);
  }

  .lang:active {
    transform: scale(0.96);
  }

  @media (max-width: 640px) {
    .links {
      display: none;
    }

    /* Tek çocuk kalınca dil düğmesi sağa yaslansın */
    .lang {
      margin-left: auto;
    }
  }
</style>
