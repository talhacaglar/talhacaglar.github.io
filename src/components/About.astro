---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];

const focus = [
  { title: 'about.focus1.title', desc: 'about.focus1.desc' },
  { title: 'about.focus2.title', desc: 'about.focus2.desc' },
  { title: 'about.focus3.title', desc: 'about.focus3.desc' },
] as const;

const stats = [
  { value: 'about.stat1.value', label: 'about.stat1.label' },
  { value: 'about.stat2.value', label: 'about.stat2.label' },
  { value: 'about.stat3.value', label: 'about.stat3.label' },
] as const;
---

<section class="section" id="about">
  <div class="container">
    <div class="split">
      <div class="text reveal">
        <span class="section-label" data-i18n="about.label">{t['about.label']}</span>
        <h2 class="section-title" data-i18n="about.title">{t['about.title']}</h2>

        <div class="paragraphs">
          <p data-i18n="about.p1">{t['about.p1']}</p>
          <p data-i18n="about.p2">{t['about.p2']}</p>
          <p data-i18n="about.p3">{t['about.p3']}</p>
        </div>
      </div>

      <ul class="focus">
        {
          focus.map((item, i) => (
            <li class="focus-card glass reveal" style={`transition-delay: ${0.08 * (i + 1)}s`}>
              <span class="focus-bar" aria-hidden="true" />
              <h3 class="focus-title" data-i18n={item.title}>
                {t[item.title]}
              </h3>
              <p class="focus-desc" data-i18n={item.desc}>
                {t[item.desc]}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="stats reveal">
      {
        stats.map((stat) => (
          <div class="stat glass">
            <span class="value" data-i18n={stat.value}>
              {t[stat.value]}
            </span>
            <span class="label" data-i18n={stat.label}>
              {t[stat.label]}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .paragraphs {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .paragraphs p {
    font-size: clamp(1rem, 1.7vw, 1.125rem);
    line-height: 1.65;
    color: var(--text-muted);
    letter-spacing: -0.005em;
  }

  /* ---------- Odak kartları ---------- */

  .focus {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    list-style: none;
  }

  .focus-card {
    position: relative;
    padding: 1.5rem 1.5rem 1.5rem 1.75rem;
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.55s var(--ease),
      background-color 0.35s var(--ease-smooth),
      box-shadow 0.55s var(--ease),
      opacity 0.9s var(--ease);
  }

  .focus-card:hover {
    transform: translateX(4px);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-shadow-hover), inset 0 1px 0 var(--glass-highlight);
  }

  .focus-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
  }

  .focus-title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--accent);
  }

  .focus-desc {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  /* ---------- İstatistikler ---------- */

  .stats {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    transition-delay: 0.15s;
  }

  .stat {
    padding: 1.75rem 1.5rem;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    transition:
      transform 0.5s var(--ease),
      background-color 0.35s var(--ease-smooth),
      box-shadow 0.5s var(--ease);
  }

  .stat:hover {
    transform: translateY(-4px);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-shadow-hover), inset 0 1px 0 var(--glass-highlight);
  }

  .value {
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent);
  }

  .label {
    font-size: 0.875rem;
    color: var(--text-faint);
    letter-spacing: -0.005em;
  }

  @media (max-width: 880px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .stats {
      grid-template-columns: 1fr;
    }

    .stat {
      padding: 1.25rem 1.375rem;
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
  }
</style>
