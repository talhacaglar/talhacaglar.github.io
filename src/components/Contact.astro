---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];

const socials = [
  { name: 'GitHub', href: 'https://github.com/talhacaglar' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/talhacaglar1/' },
  { name: 'Telegram', href: 'https://t.me/Cgllar' },
] as const;
---

<section class="section contact" id="contact">
  <div class="lenses" aria-hidden="true">
    <span class="lens lens-a"></span>
    <span class="lens lens-b"></span>
  </div>

  <div class="container inner">
    <div class="reveal">
      <span class="section-label" data-i18n="contact.label">{t['contact.label']}</span>
      <h2 class="section-title title" data-i18n="contact.title">{t['contact.title']}</h2>
      <p class="section-subtitle subtitle" data-i18n="contact.subtitle">
        {t['contact.subtitle']}
      </p>
    </div>

    <div class="actions reveal">
      <a class="btn btn-primary" href="mailto:talhacaglarr@proton.me" data-i18n="contact.email">
        {t['contact.email']}
      </a>
    </div>

    <ul class="socials reveal">
      {
        socials.map((social) => (
          <li>
            <a class="social glass" href={social.href} target="_blank" rel="noopener noreferrer">
              {social.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    position: relative;
    background: var(--section-veil);
    border-top: 1px solid var(--border);
    overflow: hidden;
  }

  .lenses {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .lens {
    position: absolute;
    border-radius: 50%;
    background: var(--glass-bg-faint);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow), var(--glass-rim);
  }

  .lens-a {
    top: 12%;
    left: 6%;
    width: min(220px, 24vw);
    aspect-ratio: 1;
  }

  .lens-b {
    bottom: 8%;
    right: 5%;
    width: min(280px, 30vw);
    aspect-ratio: 1;
  }

  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    max-width: 16ch;
    margin-inline: auto;
  }

  .subtitle {
    margin-inline: auto;
  }

  .actions {
    margin-top: 2.25rem;
    transition-delay: 0.1s;
  }

  .socials {
    margin-top: 2.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    list-style: none;
    transition-delay: 0.18s;
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5625rem 1.25rem;
    border-radius: 980px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    transition:
      transform 0.45s var(--ease),
      background-color 0.35s var(--ease-smooth),
      color 0.3s var(--ease-smooth),
      box-shadow 0.45s var(--ease);
  }

  .social::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .social:hover {
    transform: translateY(-3px);
    background: var(--glass-bg-strong);
    color: var(--accent);
    box-shadow: var(--glass-shadow-hover), var(--glass-rim);
  }

  @media (max-width: 720px) {
    .lens {
      display: none;
    }
  }
</style>
