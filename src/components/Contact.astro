---
import { translations, DEFAULT_LANG } from '../data/translations';

const t = translations[DEFAULT_LANG];

const socials = [
  { name: 'GitHub', href: 'https://github.com/talhacaglar', tone: 'var(--indigo)' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/talhacaglar1/', tone: 'var(--blue)' },
  { name: 'Telegram', href: 'https://t.me/Cgllar', tone: 'var(--teal)' },
] as const;
---

<section class="section contact" id="contact">
  <div class="glow" aria-hidden="true">
    <span class="orb orb-a"></span>
    <span class="orb orb-b"></span>
  </div>

  <div class="container inner">
    <div class="reveal">
      <span class="section-label" style="--tone: var(--orange)" data-i18n="contact.label">
        {t['contact.label']}
      </span>
      <h2 class="section-title title" data-i18n="contact.title">{t['contact.title']}</h2>
      <p class="section-subtitle subtitle" data-i18n="contact.subtitle">
        {t['contact.subtitle']}
      </p>
    </div>

    <div class="actions reveal">
      <a class="btn btn-primary" href="mailto:talhacaglarr@proton.me" data-i18n="contact.email">
        {t['contact.email']}
      </a>
    </div>

    <ul class="socials reveal">
      {
        socials.map((social) => (
          <li>
            <a
              class="social"
              style={`--tone: ${social.tone}`}
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {social.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    position: relative;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
  }

  .orb-a {
    top: -30%;
    left: 8%;
    width: min(620px, 70vw);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--orange) var(--glow-strength), transparent) 0%,
      transparent 66%
    );
  }

  .orb-b {
    bottom: -35%;
    right: 4%;
    width: min(660px, 74vw);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--pink) var(--glow-strength), transparent) 0%,
      transparent 66%
    );
  }

  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    max-width: 16ch;
  }

  .subtitle {
    margin-inline: auto;
  }

  .actions {
    margin-top: 2.25rem;
    transition-delay: 0.1s;
  }

  .socials {
    margin-top: 2.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    list-style: none;
    transition-delay: 0.18s;
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5625rem 1.25rem;
    border-radius: 980px;
    background: color-mix(in oklab, var(--tone) var(--tint-strength), var(--card-bg));
    border: 1px solid color-mix(in oklab, var(--tone) 22%, transparent);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--tone);
    transition:
      transform 0.45s var(--ease),
      border-color 0.35s var(--ease-smooth),
      background-color 0.35s var(--ease-smooth);
  }

  .social::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .social:hover {
    transform: translateY(-3px);
    background: color-mix(in oklab, var(--tone) var(--tint-strength-strong), var(--card-bg));
    border-color: color-mix(in oklab, var(--tone) 48%, transparent);
  }
</style>
